FROM node:22.20-bookworm-slim AS aiwrapper-build

WORKDIR /build
COPY vendor/aiwrapper ./
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm run build \
    && npm prune --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:22.20-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 heswe \
    && useradd --uid 10001 --gid 10001 --no-create-home heswe

WORKDIR /opt/heswe

COPY package.json package-lock.json ./
COPY packages/agents/package.json packages/agents/package.json
COPY packages/client/package.json packages/client/package.json
COPY packages/desktop/package.json packages/desktop/package.json
COPY packages/heswe/package.json packages/heswe/package.json
COPY packages/web/package.json packages/web/package.json
COPY vendor/aiwrapper/package.json vendor/aiwrapper/package.json
COPY --from=aiwrapper-build /build/dist vendor/aiwrapper/dist
COPY --from=aiwrapper-build /build/node_modules vendor/aiwrapper/node_modules
RUN npm ci --omit=dev

COPY packages/agents/src packages/agents/src
COPY packages/heswe/src packages/heswe/src
COPY packages/heswe/builtin-skills packages/heswe/builtin-skills

ENV HOME=/tmp/heswe
ENV NODE_ENV=production

USER 10001:10001
ENTRYPOINT ["node", "/opt/heswe/packages/agents/src/worker.js"]
CMD ["--workspace", "/workspace"]
