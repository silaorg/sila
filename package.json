{
  "name": "heswe",
  "description": "Root package for Heswe's monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "workspace": "node packages/heswe/src/cli.js",
    "dev": "concurrently --kill-others-on-fail -n workspace,web -c yellow,cyan \"npm run dev:workspace\" \"npm run dev:web\"",
    "dev:workspace": "node --watch packages/heswe/src/cli.js run test-workspace",
    "dev:web": "npm run dev -w web",
    "test": "npm run --workspaces --if-present test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "cookie": "0.7.2",
    "uuid": "11.1.1"
  }
}
